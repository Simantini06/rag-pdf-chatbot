# Copy to .env and fill in. Without a key the app falls back to extractive answers.
ANTHROPIC_API_KEY=

# Optional overrides (defaults shown)
# Claude model used for generation
RAG_MODEL=claude-sonnet-5-5
# Embedding backend: auto | sentence-transformers | tfidf
RAG_EMBEDDER=auto
# Characters per chunk, and characters shared between neighbouring chunks
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=150
# Number of chunks retrieved per question
RAG_TOP_K=4
# Where the local vector index is persisted
RAG_INDEX_DIR=.rag_index
